<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal -->
    <menuitem name="Videoclub" id="menu_videoclub" sequence="49"/>

    <!-- *********************** -->
    <!-- ** VISTAS PARA FILMS ** -->
    <!-- *********************** -->

    <!-- Vista formulario para Films -->
    <record model="ir.ui.view" id="view_videoclub_film_form">
        <field name="name">videoclub.film.form</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Added a title since 'name' field was missing in original views -->
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" placeholder="Film Title" options="{'no_create': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="description" widget="text"/>
                            <field name="hours"/>
                            <field name="tipus"/>
                        </group>
                        <group>
                            <field name="state" widget="statusbar"/>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="reserved" widget="boolean_toggle"/>
                            <field name="reservation_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cast">
                            <field name="actor_ids" widget="many2many_tags"/>
                            <field name="director_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista árbol para Films -->
    <record model="ir.ui.view" id="view_videoclub_film_tree">
        <field name="name">videoclub.film.tree</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>  <!-- Using product_id as main identifier since name isn't in model -->
                <field name="category_id"/>
                <field name="state" widget="badge"/>
                <field name="reserved" widget="boolean_toggle"/>
                <field name="reservation_date"/>
            </tree>
        </field>
    </record>

    <!-- Vista búsqueda para Films -->
    <record model="ir.ui.view" id="view_videoclub_film_search">
        <field name="name">videoclub.film.search</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="state"/>
                <filter string="Reserved" name="reserved" domain="[('reserved', '=', True)]"/>
                <filter string="Free" name="free" domain="[('state', '=', 'free')]"/>
            </search>
        </field>
    </record>

    <!-- Acción para Films -->
    <record model="ir.actions.act_window" id="action_videoclub_film">
        <field name="name">Films</field>
        <field name="res_model">videoclub.film</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_videoclub_film_search"/>
    </record>

    <!-- Menú Films -->
    <menuitem name="Films" id="menu_videoclub_film" parent="menu_videoclub" sequence="52" action="action_videoclub_film"/>

    <!-- *************************** -->
    <!-- ** VISTAS PARA DIRECTORS ** -->
    <!-- *************************** -->

    <!-- Vista formulario para Directors -->
    <record model="ir.ui.view" id="view_videoclub_director_form">
        <field name="name">videoclub.director.form</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Director Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="nationality" options="{'no_create': True}"/>
                            <field name="studies"/>
                            <field name="years_of_experience"/>
                        </group>
                        <group>
                            <field name="film_id" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista árbol para Directors -->
    <record model="ir.ui.view" id="view_videoclub_director_tree">
        <field name="name">videoclub.director.tree</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="years_of_experience"/>
                <field name="studies"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <!-- Vista búsqueda para Directors -->
    <record model="ir.ui.view" id="view_videoclub_director_search">
        <field name="name">videoclub.director.search</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nationality"/>
                <filter string="Experienced" name="experienced" domain="[('years_of_experience', '>', 5)]"/>
            </search>
        </field>
    </record>

    <!-- Acción para Directors -->
    <record model="ir.actions.act_window" id="action_videoclub_director">
        <field name="name">Directors</field>
        <field name="res_model">videoclub.director</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_videoclub_director_search"/>
    </record>

    <!-- Menú Directors -->
    <menuitem name="Directors" id="menu_videoclub_director" parent="menu_videoclub" sequence="51" action="action_videoclub_director"/>

    <!-- ************************ -->
    <!-- ** VISTAS PARA ACTORS ** -->
    <!-- ************************ -->

    <!-- Vista formulario para Actors -->
    <record model="ir.ui.view" id="view_videoclub_actor_form">
        <field name="name">videoclub.actor.form</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Actor Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="nationality" options="{'no_create': True}"/>
                            <field name="studies"/>
                            <field name="years_of_experience"/>
                        </group>
                        <group>
                            <field name="film_id" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista árbol para Actors -->
    <record model="ir.ui.view" id="view_videoclub_actor_tree">
        <field name="name">videoclub.actor.tree</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="years_of_experience"/>
                <field name="studies"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <!-- Vista búsqueda para Actors -->
    <record model="ir.ui.view" id="view_videoclub_actor_search">
        <field name="name">videoclub.actor.search</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nationality"/>
                <filter string="Experienced" name="experienced" domain="[('years_of_experience', '>', 5)]"/>
            </search>
        </field>
    </record>

    <!-- Acción para Actors -->
    <record model="ir.actions.act_window" id="action_videoclub_actor">
        <field name="name">Actors</field>
        <field name="res_model">videoclub.actor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_videoclub_actor_search"/>
    </record>

    <!-- Menú Actors -->
    <menuitem name="Actors" id="menu_videoclub_actor" parent="menu_videoclub" sequence="53" action="action_videoclub_actor"/>

    <!-- **************************** -->
    <!-- ** VISTAS PARA CATEGORIAS ** -->
    <!-- **************************** -->
    <record model="ir.ui.view" id="view_videoclub_category_tree">
        <field name="name">videoclub.film.category.tree</field>
        <field name="model">videoclub.film.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="complete_name"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_videoclub_category_form">
        <field name="name">videoclub.film.category.form</field>
        <field name="model">videoclub.film.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id" options="{'no_create': True}"/>
                        <field name="complete_name" readonly="1"/>
                        <field name="description" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_videoclub_category">
        <field name="name">Film Categories</field>
        <field name="res_model">videoclub.film.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Categories" id="menu_videoclub_category" parent="menu_videoclub"
             sequence="50" action="action_videoclub_category"/>
</odoo>