<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal -->
    <menuitem name="Videoclub" id="menu_videoclub" sequence="10"/>

    <!-- PELÍCULAS (FILMS) -->
    <record model="ir.ui.view" id="view_videoclub_film_form">
        <field name="name">videoclub.film.form</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <form string="Film">

                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="category_id"/>
                            <field name="hours"/>
                            <field name="tipus"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="client_id" attrs="{'required': [('state', '=', 'rented')]}"/>
                            <field name="reserved"/>
                            <field name="reservation_date" attrs="{'invisible': [('reserved', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Cast &amp; Crew">
                            <group>
                                <field name="actor_ids" widget="many2many_tags"/>
                                <field name="director_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista para películas -->
    <record model="ir.ui.view" id="view_videoclub_film_tree">
        <field name="name">videoclub.film.tree</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <tree string="Films" >
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="hours"/>
                <field name="state"/>
                <field name="tipus"/>
                <field name="reserved"/>
                <field name="client_id"/>
            </tree>
        </field>
    </record>

    <!-- CATEGORÍAS -->
    <record model="ir.ui.view" id="view_videoclub_film_category_form">
        <field name="name">videoclub.film.category.form</field>
        <field name="model">videoclub.film.category</field>
        <field name="arch" type="xml">
            <form string="Film Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="complete_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_videoclub_film_category_tree">
        <field name="name">videoclub.film.category.tree</field>
        <field name="model">videoclub.film.category</field>
        <field name="arch" type="xml">
            <tree string="Film Categories">
                <field name="complete_name"/>
                <field name="name"/>
                <field name="parent_id"/>
            </tree>
        </field>
    </record>

    <!-- DIRECTORES -->
    <record model="ir.ui.view" id="view_videoclub_director_form">
        <field name="name">videoclub.director.form</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <form string="Director">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="years_of_experience"/>
                            <field name="nationality"/>
                        </group>
                        <group>
                            <field name="studies"/>
                            <field name="film_id" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_videoclub_director_tree">
        <field name="name">videoclub.director.tree</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <tree string="Directors">
                <field name="name"/>
                <field name="years_of_experience"/>
                <field name="studies"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <!-- ACTORES -->
    <record model="ir.ui.view" id="view_videoclub_actor_form">
        <field name="name">videoclub.actor.form</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <form string="Actor">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="years_of_experience"/>
                            <field name="nationality"/>
                        </group>
                        <group>
                            <field name="studies"/>
                            <field name="film_id" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_videoclub_actor_tree">
        <field name="name">videoclub.actor.tree</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <tree string="Actors">
                <field name="name"/>
                <field name="years_of_experience"/>
                <field name="studies"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <!-- Acciones de ventana -->
    <record model="ir.actions.act_window" id="action_videoclub_film">
        <field name="name">Films</field>
        <field name="res_model">videoclub.film</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_videoclub_film_category">
        <field name="name">Categories</field>
        <field name="res_model">videoclub.film.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_videoclub_director">
        <field name="name">Directors</field>
        <field name="res_model">videoclub.director</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_videoclub_actor">
        <field name="name">Actors</field>
        <field name="res_model">videoclub.actor</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Elementos del menú -->
    <menuitem name="Films" id="menu_videoclub_film"
              parent="menu_videoclub" action="action_videoclub_film" sequence="10"/>

    <menuitem name="Categories" id="menu_videoclub_category"
              parent="menu_videoclub" action="action_videoclub_film_category" sequence="20"/>

    <menuitem name="Directors" id="menu_videoclub_director"
              parent="menu_videoclub" action="action_videoclub_director" sequence="30"/>

    <menuitem name="Actors" id="menu_videoclub_actor"
              parent="menu_videoclub" action="action_videoclub_actor" sequence="40"/>

</odoo>