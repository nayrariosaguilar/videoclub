<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal -->
    <menuitem name="Videoclub" id="menu_videoclub" sequence="49"/>

    <!-- *********************** -->
    <!-- ** VISTAS PARA FILMS ** -->
    <!-- *********************** -->

    <!-- Vista formulario para Films -->
    <record model="ir.ui.view" id="view_videoclub_film_form">
        <field name="name">videoclub.film.form</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="description"/>
                        <field name="hours"/>
                        <field name="product_id"/>
                        <field name="client_id"/>
                        <field name="state"/>
                        <field name="tipus"/>
                        <field name="reserved"/>
                        <field name="reservation_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista árbol para Films -->
    <record model="ir.ui.view" id="view_videoclub_film_tree">
        <field name="name">videoclub.film.tree</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="category_id"/>
                <field name="state"/>
                <field name="reserved"/>
                <field name="reservation_date"/>
            </tree>
        </field>
    </record>

    <!-- Vista búsqueda para Films -->
    <record model="ir.ui.view" id="view_videoclub_film_search">
        <field name="name">videoclub.film.search</field>
        <field name="model">videoclub.film</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <!-- Acción para Films -->
    <record model="ir.actions.act_window" id="action_videoclub_film">
        <field name="name">Films</field>
        <field name="res_model">videoclub.film</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_videoclub_film_search"/>
    </record>

    <!-- Menú Films -->
    <menuitem name="Films" id="menu_videoclub_film" parent="menu_videoclub" sequence="52" action="action_videoclub_film"/>

    <!-- *************************** -->
    <!-- ** VISTAS PARA DIRECTORS ** -->
    <!-- *************************** -->

    <!-- Vista formulario para Directors -->
    <record model="ir.ui.view" id="view_videoclub_director_form">
        <field name="name">videoclub.director.form</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="film_id" widget="many2many_tags"/>
                        <field name="years_of_experience"/>
                        <field name="studies"/>
                        <field name="nationality"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista árbol para Directors -->
    <record model="ir.ui.view" id="view_videoclub_director_tree">
        <field name="name">videoclub.director.tree</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="years_of_experience"/>
                <field name="studies"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <!-- Vista búsqueda para Directors -->
    <record model="ir.ui.view" id="view_videoclub_director_search">
        <field name="name">videoclub.director.search</field>
        <field name="model">videoclub.director</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nationality"/>
            </search>
        </field>
    </record>

    <!-- Acción para Directors -->
    <record model="ir.actions.act_window" id="action_videoclub_director">
        <field name="name">Directors</field>
        <field name="res_model">videoclub.director</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_videoclub_director_search"/>
    </record>

    <!-- Menú Directors -->
    <menuitem name="Directors" id="menu_videoclub_director" parent="menu_videoclub" sequence="51" action="action_videoclub_director"/>

    <!-- ************************ -->
    <!-- ** VISTAS PARA ACTORS ** -->
    <!-- ************************ -->

    <!-- Vista formulario para Actors -->
    <record model="ir.ui.view" id="view_videoclub_actor_form">
        <field name="name">videoclub.actor.form</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="film_id" widget="many2many_tags"/>
                        <field name="years_of_experience"/>
                        <field name="studies"/>
                        <field name="nationality"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista árbol para Actors -->
    <record model="ir.ui.view" id="view_videoclub_actor_tree">
        <field name="name">videoclub.actor.tree</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="years_of_experience"/>
                <field name="studies"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <!-- Vista búsqueda para Actors -->
    <record model="ir.ui.view" id="view_videoclub_actor_search">
        <field name="name">videoclub.actor.search</field>
        <field name="model">videoclub.actor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nationality"/>
            </search>
        </field>
    </record>

    <!-- Acción para Actors -->
    <record model="ir.actions.act_window" id="action_videoclub_actor">
        <field name="name">Actors</field>
        <field name="res_model">videoclub.actor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_videoclub_actor_search"/>
    </record>

    <!-- Menú Actors -->
    <menuitem name="Actors" id="menu_videoclub_actor" parent="menu_videoclub" sequence="53" action="action_videoclub_actor"/>

</odoo>